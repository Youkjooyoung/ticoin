# AWS 운영 배포용 환경변수 예시
# 실제 .env.prod 파일을 만들고 해당 값을 채워서 사용
# 사용: docker compose --env-file .env.prod -f docker-compose.prod.yml up -d

# Postgres
DB_NAME=ticoin
DB_USER=ticoin_app
DB_PASSWORD=change-me-strong-password
DB_POOL_SIZE=20

# Backend
CORS_ORIGINS=https://ticoin.example.com
WS_INTERVAL_MS=15000
ALERT_INTERVAL_MS=20000
LOG_LEVEL=INFO

# 외부 API (선택)
CMC_API_KEY=

# 이미지 태그 (ECR 푸시 후 사용)
# BACKEND_IMAGE=123456789012.dkr.ecr.ap-northeast-2.amazonaws.com/ticoin-backend:0.3.0
# FRONTEND_IMAGE=123456789012.dkr.ecr.ap-northeast-2.amazonaws.com/ticoin-frontend:0.3.0

# 프론트엔드 포트 (ALB 뒤면 80, 직접 노출하면 443 리버스프록시 권장)
FRONTEND_PORT=80
