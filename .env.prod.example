# 프로덕션 배포 예시 환경변수

DB_NAME=ticoin
DB_USER=ticoin_app
DB_PASSWORD=change-me-strong-password
DB_POOL_SIZE=20

TICOIN_CORS_ORIGINS=https://ticoin.example.com
TICOIN_WS_INTERVAL_MS=15000
TICOIN_ALERT_INTERVAL_MS=20000
LOG_LEVEL_APP=INFO

UPBIT_URL=https://api.upbit.com
UPBIT_WS_URL=wss://api.upbit.com/websocket/v1
CMC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_URL=https://api.openai.com

FRONTEND_PORT=80

